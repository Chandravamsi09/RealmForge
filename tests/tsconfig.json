{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": true,
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@realmforge/shared": ["../shared/src"],
      "@realmforge/shared/*": ["../shared/src/*"],
      "@realmforge/server": ["../server/src"],
      "@realmforge/server/*": ["../server/src/*"]
    }
  },
  "include": ["src/**/*"]
}
