# Application Environment
NODE_ENV=development
PORT=4000
CLIENT_PORT=3000
CLIENT_URL=http://localhost:3000

# Authentication & Security (Use strong random strings in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=realmforge_dev
DB_USER=postgres
DB_PASSWORD=postgres_password_placeholder
DB_SSL=false
DATABASE_URL=postgresql://postgres:postgres_password_placeholder@localhost:5432/realmforge_dev

# Redis Cache & Matchmaking
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Game Server Configuration
TICK_RATE_HZ=20
MAX_PLAYERS_PER_ROOM=4
ADMIN_INITIAL_KEY=admin_secret_setup_key_example
